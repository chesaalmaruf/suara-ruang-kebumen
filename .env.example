# ==========================================
# KONFIGURASI DATABASE & ENVIRONMENT
# SUARA RUANG: LAPOR AKSES KEBUMEN
# ==========================================

# MONGODB_URI: Connection string ke MongoDB Atlas atau MongoDB Local
# Contoh MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Contoh MongoDB Local: mongodb://localhost:27017
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# MONGODB_DB: Nama database (Default: suararuang_kebumen)
MONGODB_DB="suararuang_kebumen"

# GEMINI_API_KEY: Opsional untuk fitur AI analisis gambar/deskripsi
GEMINI_API_KEY=""

# APP_URL: URL publik aplikasi saat dideploy (misal di Vercel: https://suara-ruang-kebumen.vercel.app)
APP_URL="http://localhost:3000"
